{
  "manifest_version": 3,
  "name": "Portal Timoni - Estoque",
  "version": "0.1.0",
  "version_name": "0.1.0-mock",
  "description": "Central de necessidades de compra: balcão informa produto em falta, estoque responde com pedido em andamento ou recebido para compra.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "action": {
    "default_title": "Portal Timoni - Estoque",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
