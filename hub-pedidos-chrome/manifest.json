{
  "manifest_version": 3,
  "name": "Portal Timoni - Compras",
  "version": "1.1.0",
  "version_name": "1.1.0-alpha.25",
  "description": "Fluxo assistido de compras: Trello -> Google Drive -> Planilha -> Bessani -> Conferência -> Trello, com abertura de abas somente sob demanda.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://trello.com/*",
    "https://drive.google.com/*",
    "https://docs.google.com/spreadsheets/*",
    "https://script.google.com/*"
  ],
  "action": {
    "default_title": "Portal Timoni - Compras",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://trello.com/*"],
      "js": ["lib/validators.js", "content/trello-content.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://docs.google.com/spreadsheets/*"],
      "js": ["lib/validators.js", "content/sheets-content.js"],
      "run_at": "document_end"
    }
  ]
}
